# ==========================================================
# 1. CONFIGURACIÓN DE MICROSOFT 365 (MODO LOCAL vs GRAPH API)
# ==========================================================
# Modo de conexión:
# - "outlook_local" -> Conecta directo al Outlook clásico de tu PC (sin Azure AD ni Admin TI)
# - "graph"         -> Conecta por nube Microsoft Graph API (OAuth2, para tenants abiertos o Hotmail/Outlook personal)
M365_BACKEND="outlook_local"

# (Opcional para "outlook_local") Si tienes varias cuentas en tu Outlook de escritorio, escribe aquí cuál usar:
M365_ACCOUNT_EMAIL=""

# --- Parámetros exclusivos para M365_BACKEND="graph" ---
# Application (client) ID registrado en Azure Entra ID
M365_CLIENT_ID="tu-application-client-id-aqui"

# Directory (tenant) ID:
# - Usa "common" si registraste la app como Multitenant o para cuentas personales (@hotmail.com / @outlook.com)
# - Usa el Directory (tenant) ID de tu empresa si registraste la app como Single Tenant
M365_TENANT_ID="common"

# Flujo de autenticación: "interactive" (abre ventana de navegador) o "device_code" (muestra código en consola)
M365_AUTH_FLOW="interactive"

# Permisos delegados solicitados (separados por coma) para M365_BACKEND="graph":
# - Completo (Correo + Calendario): "User.Read,Mail.Read,Mail.ReadWrite,Mail.Send,Calendars.Read,Calendars.ReadWrite"
# - Solo Correo:                    "User.Read,Mail.Read,Mail.ReadWrite,Mail.Send"
# - Solo Calendario:                "User.Read,Calendars.Read,Calendars.ReadWrite"
# - Solo Lectura:                   "User.Read,Mail.Read,Calendars.Read"
M365_SCOPES="User.Read,Mail.Read,Mail.ReadWrite,Mail.Send,Calendars.Read,Calendars.ReadWrite"

# ==========================================================
# 2. CONFIGURACIÓN DE IA LOCAL (LM STUDIO U OLLAMA)
# ==========================================================
# Para LM Studio: http://localhost:1234/v1
# Para Ollama:    http://localhost:11434/v1
LLM_BASE_URL="http://localhost:1234/v1"

# Nombre del modelo cargado en LM Studio u Ollama (usa "local-model" para autodetección o fija uno, ej. "qwen/qwen3.6-27b")
LLM_MODEL="local-model"
LLM_API_KEY="lm-studio"
LLM_TEMPERATURE=0.2

# ==========================================================
# 3. MOTOR DE MONITOREO EN SEGUNDO PLANO (DAEMON)
# ==========================================================
POLL_INTERVAL_SECONDS=120
MAX_EMAILS_PER_BATCH=10
DRY_RUN=false
